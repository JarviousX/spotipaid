# SpotiPaid environment — copy to .env and fill in values
# Never commit real secrets.

# Database (SQLite for local demo)
DATABASE_URL="file:./dev.db"

# Demo mode — uses seeded data and demo providers when APIs unset
DEMO_MODE=true
# Client-visible demo badge (must match DEMO_MODE for UI labeling)
NEXT_PUBLIC_DEMO_MODE=true

# Fee splits in basis points (must sum to 10000)
FEE_ARTIST_BPS=8000
FEE_PROTOCOL_BPS=2000

# SOL charged when launching with a connected wallet (sent to adm1n fee wallet)
LAUNCH_FEE_SOL=0.05

# Spotify Web API (client credentials). Leave blank to use demo music provider.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Solana RPC (optional — demo chain adapter when unset)
SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_RPC_URL=

# pump.fun / launchpad API (optional)
PUMPFUN_API_KEY=

# ─── ADM1N privileged console (/adm1n) ───────────────────────────────────────
# Long random JWT HMAC secret (required in production)
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# Short-lived admin session (seconds). Default 3600 (1 hour).
ADMIN_SESSION_TTL=3600

# bcrypt hash of the admin passphrase — NEVER put the plaintext passphrase here
# or in source control. Generate with:
#   node scripts/hash-admin-passphrase.mjs
# IMPORTANT: escape every $ as \$ — Next.js dotenv-expand otherwise mangles bcrypt hashes.
#   ADMIN_PASSPHRASE_HASH=\$2b\$12\$....
ADMIN_PASSPHRASE_HASH=

# Optional: seed a DB AdminUser for legacy /admin email login (hashed at seed time)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Feature flags
FEATURE_ARTIST_CLAIMS=true
FEATURE_PAYOUTS=true
FEATURE_LAUNCHPAD_INGEST=true
FEATURE_PUBLIC_DISCOVERY=true
FEATURE_ADMIN_IMPERSONATION=false
